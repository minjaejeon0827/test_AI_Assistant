# ============================================================================
# Python / Streamlit 프로젝트용 .gitignore
# ============================================================================

# --- 보안: 절대 커밋 금지 -----------------------------------------------------
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml
*.pem
*.key
credentials.json

# --- 가상환경 ---------------------------------------------------------------
.venv/
venv/
env/
ENV/
chatbot_env/
*.egg-info/

# --- Python 캐시 ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/

# --- 에디터 / IDE -----------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
.history/

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- 로그 / 임시 파일 --------------------------------------------------------
*.log
logs/
tmp/
*.tmp
*.bak

# --- 프로젝트별 ------------------------------------------------------------
# README에 첨부하는 이미지는 커밋 대상이므로 assets/ 는 무시하지 않습니다.
# 대신 원본 녹화 파일 등 용량 큰 중간 산출물만 제외합니다.
*.mp4
*.mov
recordings/