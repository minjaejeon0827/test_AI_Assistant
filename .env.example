# 이 파일을 .env 로 복사해 쓴다. .env 는 커밋하지 않는다(.gitignore).
# 키가 없어도 앱은 추출형 답변 모드로 동작한다.

# 배포자 키 — 넣으면 방문자가 키 없이 생성형 답변을 쓴다. 사용량 상한이 이 키를 보호한다.
OPENAI_API_KEY=

# 상담원 연결 문구. 공개 데모에서는 실제 번호를 넣지 않는다.
# ASSISTANT_SUPPORT_CONTACT=㈜상상진화 기술지원 콜센터 02-0000-0000

# ASSISTANT_TOKENIZER=kiwi            # kiwi(형태소, 기본) | bigram
# ASSISTANT_LLM_BACKEND=chat          # chat | responses   ← 생성 평가 결론 반영 (docs/runbook_vector_generate.md)
# ASSISTANT_W_VECTOR=0.4              # 하이브리드 순위 기각 시 0
# ASSISTANT_MAX_CALLS=30              # 대화당 LLM 호출 수
# ASSISTANT_MAX_TOKENS=60000          # 대화당 토큰
# ASSISTANT_MAX_CALLS_PER_DAY=500     # 전체 일일 호출 수
# ASSISTANT_HANDOFF_MIN_VECTOR=1.01   # 벡터 게이트 — eval_rag.py --vector 결론 반영
